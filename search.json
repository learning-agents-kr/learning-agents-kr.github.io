---
layout: none
---
[
  {% for post in site.posts %}
    {
      "title"     : "{{ post.title | escape }}",
      "url"       : "{{ site.baseurl }}{{ post.url }}",
      "date"      : "{{ post.date | date: '%Y, %b %d' }}",
      "presenter" : "{{ post.presenter | escape }}",
      "tags"      : "{{ post.tags | join: ', ' | escape }}",
      "img"       : "{{ post.img | escape }}"
    }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
